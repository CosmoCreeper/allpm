{
  "name": "allpm",
  "version": "1.0.2",
  "description": "Use bun, deno, pnpm, yarn, or npm to execute a command",
  "license": "MIT",
  "scripts": {
    "lint": "eslint bin/ index.js && prettier . --check --cache",
    "lint:fix": "eslint bin/ index.js --fix && prettier . --write"
  },
  "engines": {
    "node": ">=8.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:CosmoCreeper/allpm.git"
  },
  "author": "CosmoCreeper",
  "keywords": [
    "bun",
    "pnpm",
    "yarn",
    "npm",

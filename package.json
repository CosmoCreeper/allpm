  "main": "index.js",
  "files": [
    "index.js",
    "bin/"
  ],
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "package-directory": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.2"
  }
